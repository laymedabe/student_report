# ====================================================================
# SUPABASE CONFIGURATION (Copy to .env or add to Vercel Environment Variables)
# ====================================================================

# 1. Your Supabase Project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase API Key (Use the "anon" public key or "service_role" secret key)
SUPABASE_KEY=your-supabase-api-key-here

# Optional: Port for local standalone Node server (defaults to 3001)
PORT=3001
